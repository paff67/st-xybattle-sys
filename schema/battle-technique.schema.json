{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paff67.github.io/st-xybattle-sys/battle-technique.schema.json",
  "title": "Battle Technique Registry Entry",
  "type": "object",
  "required": ["id", "name", "rank", "element", "corePrinciple", "mechanics", "techniques", "synergies", "narrativeGuidance", "version", "visibility", "ruleRefs"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
    "name": {"type": "string", "minLength": 1},
    "rank": {"type": "string"},
    "element": {"type": "string"},
    "corePrinciple": {"type": "string"},
    "mechanics": {"type": "array", "items": {"type": "string"}},
    "techniques": {"type": "array", "items": {"$ref": "#/$defs/technique"}},
    "synergies": {"type": "array", "items": {"type": "string"}},
    "narrativeGuidance": {"type": "array", "items": {"type": "string"}},
    "version": {"type": "string"},
    "visibility": {"type": "string", "enum": ["public", "player", "gm", "internal"]},
    "ruleRefs": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "technique": {
      "type": "object",
      "required": ["id", "name", "originalDefinition", "mechanics", "availability", "triggeredState", "visibility", "ruleRefs"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "originalDefinition": {"type": "string"},
        "mechanics": {"type": "array", "items": {"type": "string"}},
        "availability": {"type": "object", "required": ["default", "conditions"], "properties": {"default": {"type": "string"}, "conditions": {"type": "array", "items": {"type": "string"}}}},
        "triggeredState": {"type": "array", "items": {"type": "string"}},
        "visibility": {"type": "string", "enum": ["public", "player", "gm", "internal"]},
        "ruleRefs": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
